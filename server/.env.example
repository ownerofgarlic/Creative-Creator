# Copy this file to .env and fill in real values. Never commit .env.
#
# --- Mock mode ---
# Set to "true" to run the whole dashboard against realistic sample data,
# with no Google Ads or Anthropic account needed. Good for trying the UI
# before you've set up API access.
MOCK_MODE=true

# --- Google Ads API (see README "Google Ads API setup") ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Only needed if the account above is a sub-account under a manager (MCC) account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Analysis / creative suggestions ---
# Get a free key at https://console.anthropic.com (Claude has a free tier
# to start, then pay-as-you-go). Used to analyze performance and draft new
# ad copy + creative concepts. No key needed while MOCK_MODE=true.
ANTHROPIC_API_KEY=

# Context fed to the analysis so suggestions match your actual campaign.
CAMPAIGN_GOAL="Drive donations to Team Shalva NY 2026 marathon fundraiser"
LANDING_PAGE_URL=https://ownerofgarlic.github.io/Creative-Creator/
TARGET_AUDIENCE="People likely to donate to disability-inclusion causes; past donors; marathon/charity-run supporters"

PORT=3000
